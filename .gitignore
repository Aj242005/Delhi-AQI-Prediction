# Generated/intermediate data stays local. The three files the app needs to run
# from a fresh clone are explicitly whitelisted below.
*.csv
!Dataset/original_data.csv
!Dataset/anand_vihar_weather_2017_2023.csv
!Dataset/ml_ready_data.csv

# Python / notebook noise
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local live ground-sensor readings. The CAMS hour cache ships with the repo
# so a host that cannot reach Open-Meteo still starts with a full 49-hour
# window - public data, no tokens in it.
Live/*
!Live/reanalysis_seed.csv

# Retraining artifacts (candidates, backups, scheduling state)
Models/candidates/
Models/backups/
Models/retrain_state.json

# Local secrets (WAQI token)
.env

# Research material
minor project research papers/

# Local design notes from the redesign pass
.impeccable/

.vercel
.env*
